OVIRT_API_URL=https://engine.example.com/ovirt-engine/api
OVIRT_CA_FILE=/etc/pki/ovirt-engine/ca.pem
OVIRT_SSO_TOKEN_URL=https://engine.example.com/ovirt-engine/sso/oauth/token
OVIRT_SSO_SCOPE=ovirt-app-api
OMA_ENABLE_OVIRT_TOKEN_LOGIN=false
OMA_ALLOW_PASSWORD_LOGIN=false
OMA_DEMO=false
OMA_COOKIE_SECURE=true
OMA_ENABLE_WRITES=false
OMA_MAX_INVENTORY=2000
OMA_SESSION_TTL=1800
OMA_MAX_SESSION_AGE=28800
OMA_AUDIT_PATH=/var/log/oma/audit.jsonl

# Optional: server-managed Kubernetes cluster registry (see docs/kubernetes.md)
# OMA_K8S_CONFIG_FILE=/etc/oma/kubernetes/clusters.json
