[Unit]
Description=OMA FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
User=oma
Group=oma
WorkingDirectory=/opt/oma/backend
EnvironmentFile=/etc/oma/oma.env
ExecStart=/opt/oma/backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8088 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/oma

[Install]
WantedBy=multi-user.target
